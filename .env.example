# ============================================================================
#  OnTgAgent configuration — copy this file to `.env` and fill in the values.
# ============================================================================

# --- Telegram userbot (reads channels) --------------------------------------
# Get these from https://my.telegram.org  ->  API development tools
API_ID=1234567
API_HASH=your_api_hash_here

# Path where the Telethon login session is stored (created by `python login.py`)
SESSION_NAME=sessions/userbot

# --- Confirmation bot (sends you drafts) ------------------------------------
# Create a bot with @BotFather and paste its token here
BOT_TOKEN=123456:ABC-DEF...

# Your personal Telegram numeric user id (get it from @userinfobot).
# Only this user can control the agent and approve drafts.
OWNER_ID=123456789

# Channel where approved posts are published (e.g. @my_channel or -1001234567890).
# The BOT must be an administrator of this channel with "Post Messages" rights.
# Leave empty to only mark drafts as approved without auto-publishing.
TARGET_CHANNEL=

# --- Rewriting (Claude) -----------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# --- Behaviour --------------------------------------------------------------
# How often (seconds) to poll monitored channels for new posts
POLL_INTERVAL=120

# How many of the most-recent messages to look at per channel on each poll
FETCH_LIMIT=10

# SQLite database location
DB_PATH=data/ontgagent.db

# Path to the file describing YOUR writing style (see style.example.txt)
STYLE_FILE=style.txt
